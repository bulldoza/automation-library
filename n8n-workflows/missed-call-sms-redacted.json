    {
      "parameters": {
        "jsCode": "const cfg = $('Client Config').first().json;\nconst digits = (s) => String(s ?? '').replace(/\\D/g, '');\nconst rows = $input.all().map((i) => i.json);\nconst stored = $('Get Conversation State').first().json;\n\nlet state = null;\ntry { state = stored && stored.state ? JSON.parse(stored.state) : null; } catch (e) { state = null; }\n\nconst activeRow = rows.find((r) =>\n  digits(r['Business Number']) === digits(cfg.businessNumber) &&\n  digits(r['Caller Number']) === digits(cfg.callerNumber) &&\n  ['new', 'qualifying'].includes(String(r['Status'] ?? '').trim().toLowerCase())\n);\n\nlet isNewLead = true;\nlet reason = 'new_lead';\nif (state && state.optedOut === true) {\n  isNewLead = false;\n  reason = 'opted_out';\n} else if (activeRow) {\n  isNewLead = false;\n  reason = 'active_lead_exists';\n}\n\nreturn [{ json: { ...cfg, isNewLead, reason } }];\n"
      },
      "id": "d796eb6a-3b5d-4586-8e49-956a4ec1ff3d",
      "name": "Decide Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3024,
        256
      ],
      "notes": "Dedup rule: a call is part of an existing lead only if a row with the same Business Number + Caller Number has Status New or Qualifying. Qualified/Closed/Handoff rows never block a new lead."
    },
