    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst CLIENT = {\n  id: 'c4-auto-detail',\n  name: 'C4 Auto Detail Solutions',\n  shortName: 'C4',\n  businessType: 'auto detailing',\n  timezone: 'America/Phoenix',\n  hoursText: 'Mon-Fri 8am-5pm, Sat 8am-2pm, closed Sunday',\n  hours: { 1: [8, 17], 2: [8, 17], 3: [8, 17], 4: [8, 17], 5: [8, 17], 6: [8, 14] },\n  services: ['Interior Detail', 'Exterior Detail', 'Full Detail', 'Ceramic Coating', 'Paint Correction'],\n  servicesPrompt: 'interior, exterior, full detail, ceramic coating, or paint correction',\n  requiredFields: ['service', 'vehicle', 'name', 'preferred_time'],\n  inPersonScopeServices: ['Ceramic Coating', 'Paint Correction'],\n  extraRules: 'Ceramic coating and paint correction are scoped in person first, so never quote or schedule them; collect the same details and the team will follow up to arrange an in-person assessment.',\n  maxTurns: 8,\n};\n\nconst t = $now.setZone(CLIENT.timezone);\nconst window = CLIENT.hours[t.weekday];\nconst isOpen = !!window && t.hour >= window[0] && t.hour < window[1];\n\nreturn [{ json: { ...item, client: CLIENT, isOpen, sessionKey: `${item.businessNumber}:${item.callerNumber}` } }];\n"
      },
      "id": "f8c4e0d4-e6d4-4fb4-bc0e-cd582d2bd04a",
      "name": "Client Config",
      "type": "n8n-nodes-base.code",
