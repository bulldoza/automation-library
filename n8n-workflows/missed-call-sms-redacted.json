    {
      "parameters": {
        "jsCode": "const c = $json;\nconst cl = c.client;\n\nconst opening = c.isOpen\n  ? `Hi! This is ${cl.name}. Sorry we missed your call. What can we help you with - ${cl.servicesPrompt}? Reply STOP to opt out.`\n  : `Hi! This is ${cl.name}. Sorry we missed your call - we're closed right now, but the team will follow up when we open. What service do you need - ${cl.servicesPrompt}? Reply STOP to opt out.`;\n\nconst state = {\n  leadId: `L${Date.now()}`,\n  client: cl,\n  active: true,\n  status: 'new',\n  turns: 0,\n  optedOut: false,\n  lead: { name: '', service: '', vehicle: '', preferred_time: '', notes: '', summary: '' },\n  history: [{ role: 'assistant', content: opening, delivery: 'pending' }],\n  seen: [],\n  rate: [],\n  createdAt: $now.toISO(),\n};\n\nreturn [{\n  json: {\n    ...c,\n    smsMessage: opening,\n    timestamp: $now.setZone(cl.timezone).toFormat('yyyy-LL-dd HH:mm'),\n    stateJson: JSON.stringify(state),\n  },\n}];\n"
      },
